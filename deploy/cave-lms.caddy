# Installed to /etc/caddy/sites/cave-lms.caddy by deploy/deploy.sh. See docs/runbook.md, Changing the domain.
cavelms.com {
	bind 13.140.65.183
	# The app caps one upload at 2 GB and explains the refusal; this is the outer limit with room for multipart framing.
	request_body {
		max_size 2100MiB
	}
	# Browsers keep to https for a year, never sniff a type the app did not name, and send only the origin to other sites,
	# so a link with a token in its query does not leak it. The app sets the Content-Security-Policy itself.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Remove once real email delivery (#12) lands and the site is announced.
	header X-Robots-Tag "noindex, nofollow"
	# Users are in Malaysia, ~200 ms from the VPS: smaller responses mean fewer round trips. Caddy only compresses text types.
	encode zstd gzip
	reverse_proxy 127.0.0.1:8088
}

# Deployments live on their own host, so a Deployment flagged as phishing flags this host and not cavelms.com
# (docs/adr/0024-deployments-move-to-the-pages-subdomain.md). The same app answers, by host. DNS: an A record for
# `pages` at the VPS before the deploy that adds this block, or Caddy cannot get its certificate.
pages.cavelms.com {
	bind 13.140.65.183
	# The same headers as cavelms.com above. The host serves GETs only, so it has no request_body cap.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	reverse_proxy 127.0.0.1:8088
}

# Old and alternate addresses redirect forever, keeping the path (ADR 0002).
www.cavelms.com, lms.wasabietech.com {
	bind 13.140.65.183
	redir https://cavelms.com{uri} 308
}
