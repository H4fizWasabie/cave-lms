# Installed to /etc/systemd/system/cave-lms-backup.service by deploy/deploy.sh. See docs/deploy.md, Backups.
[Unit]
Description=Cave LMS nightly backup (database and uploads, local and R2)
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=cave-lms-backup-failed.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/cave-lms-backup
# restic keeps its cache here so each run does not re-read the repositories from R2.
CacheDirectory=cave-lms-backup
Environment=RESTIC_CACHE_DIR=/var/cache/cave-lms-backup
Nice=10
IOSchedulingClass=idle
